# Copy to .env and adjust. Only EXPO_PUBLIC_* variables are inlined into the bundle,
# and they are baked in at build time — restart Metro after changing this file.
# .env is gitignored; .env.example is not, so never put secrets here.

# Strapi API base URL. Leave unset to use the production default baked into src/lib/strapi.ts.
# EXPO_PUBLIC_STRAPI_URL=https://admin.ketalearn.cloud

# Set to "true" to reveal the demo-student sign-in button on the Profil and Giriş screens.
# It signs in as demo-learner@ketalearn.test against /api/auth/local. Keep off in production builds.
# EXPO_PUBLIC_KETA_DEMO_LOGIN=true
